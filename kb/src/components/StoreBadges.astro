---
// Download links for the landing page.
//
// A store's URL is a fact about a published listing, not about this repo, so
// each is passed in from the page rather than hardcoded here — and a badge with
// no URL yet simply doesn't render, so this ships before a listing is live
// without showing anyone a dead link.
//
// **These are deliberately not store badges, and carry no store logos.** The
// official Google Play badge artwork was tried and removed: it is 811x241 of
// art inside an 880x572 canvas, so matching its visible height to these buttons
// meant a box twice their height, and it never sat right. Redrawing the Play
// triangle instead — which an earlier version did — is the one thing Google's
// guidelines actually forbid, so that is not the fallback either.
//
// What is left is the honest option: name the store in plain text, which is
// ordinary nominative trademark use, and pair it with a neutral glyph that
// belongs to nobody. The Microsoft mark went the same way for the same reason.
// GitHub's Invertocat stays — GitHub's brand guidelines explicitly permit it
// for linking to GitHub, and it is the only one of the three that is licensed
// for this use.
interface Props {
  play?: string;
  microsoft?: string;
  github?: string;
}

const { play, microsoft, github } = Astro.props;
---

<div class="store-badges">
  {
    play && (
      <a class="store-badge" href={play}>
        {/* A phone — the platform, not the storefront. */}
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="2" width="12" height="20" rx="2.5" />
          <path d="M10.5 18.5h3" />
        </svg>
        <span class="store-badge-line">
          <span class="store-badge-lead">Get it on</span>
          <span class="store-badge-name">Google Play</span>
        </span>
      </a>
    )
  }
  {
    microsoft && (
      <a class="store-badge" href={microsoft}>
        {/* A desktop display, for the same reason. */}
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2.5" y="4" width="19" height="13" rx="2" />
          <path d="M8.5 21h7M12 17v4" />
        </svg>
        <span class="store-badge-line">
          <span class="store-badge-lead">Get it from</span>
          <span class="store-badge-name">Microsoft Store</span>
        </span>
      </a>
    )
  }
  {
    github && (
      <a class="store-badge" href={github}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M12 1.5a10.5 10.5 0 0 0-3.3 20.5c.5.1.7-.2.7-.5v-1.9c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.5-1.2-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.8-1.2-4.8-5.2 0-1.2.4-2.1 1.1-2.9-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.7 1.1 2.9 0 4-2.5 4.9-4.8 5.2.4.3.7 1 .7 2v2.9c0 .3.2.6.7.5A10.5 10.5 0 0 0 12 1.5Z" />
        </svg>
        <span class="store-badge-line">
          <span class="store-badge-lead">Source and releases</span>
          <span class="store-badge-name">GitHub</span>
        </span>
      </a>
    )
  }
</div>

{
  (play || microsoft) && (
    <p class="store-trademarks">
      Google Play is a trademark of Google LLC. Microsoft Store is a trademark of
      the Microsoft group of companies.
    </p>
  )
}
