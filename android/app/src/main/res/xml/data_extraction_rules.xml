<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (targetSdk >= 31) backup and device-to-device transfer: nothing.
     `android:allowBackup="false"` alone stops cloud backup but NOT device-to-device
     transfer on these releases, so every domain is excluded from both here.

     Why nothing: credentials, sources, profiles and pairing live in
     flutter_secure_storage, whose Keystore key never leaves the device, so a
     restored copy is undecryptable and the plugin wipes it (resetOnError).
     The SQLite cache would come back keyed to source ids that no longer
     exist (newSourceId() mints fresh ones) and sealed under a lost key, and a
     large catalog exceeds the 25 MB Auto Backup quota anyway. Cloud pairing is
     the supported way to carry a setup to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
